{
    "name": "@tak-ps/mbtiles-offline",
    "type": "module",
    "version": "1.4.0",
    "description": "Download Web maps into an offline MBTiles",
    "author": "Nick Ingalls <nick@ingalls.ca>",
    "main": "dist/index.js",
    "types": "index.ts",
    "bin": {
        "mbtiles-offline": "./cli.ts"
    },
    "engines": {
        "node": ">= 22"
    },
    "scripts": {
        "test": "c8 --reporter=lcov --reporter html tsx --test test/*.ts",
        "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
        "doc": "typedoc index.ts",
        "build": "node node_modules/typescript7/bin/tsc --build",
        "pretest": "npm run lint"
    },
    "dependencies": {
        "@openaddresses/batch-error": "^2.12.0",
        "@sinclair/typebox": "^0.34.41",
        "@supercharge/promise-pool": "^3.2.0",
        "@types/geojson": "^7946.0.16",
        "sharp": "^0.35.4",
        "ts-progress": "^0.1.9"
    },
    "devDependencies": {
        "@inquirer/prompts": "^8.2.0",
        "@types/minimist": "^1.2.5",
        "@types/node": "^26.0.0",
        "@types/pem": "^1.14.4",
        "@types/tape": "^5.6.0",
        "c8": "^12.0.0",
        "minimist": "^1.2.8",
        "oxlint": "^1.95.0",
        "oxlint-tsgolint": "^7.0.2008",
        "tape": "^5.6.1",
        "tsx": "^4.19.4",
        "typedoc": "^0.28.16",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript7": "npm:typescript@^7.0.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dfpc-coe/mbtiles-offline.git"
    },
    "keywords": [
        "tak",
        "atak",
        "cloudtak",
        "wintak",
        "cot",
        "cusor",
        "target",
        "map",
        "mbtiles",
        "offline"
    ],
